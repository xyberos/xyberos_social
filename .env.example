APP_ENV=development
DATABASE_URL=postgresql+psycopg://social%2B:social%2B@localhost:5433/social%2B
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=accounts@soccom.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# LOG_JSON pins structured JSON logs on or off; unset means JSON everywhere except development.
# S3-compatible object storage for attachment bytes. Attachment rows stay in PostgreSQL; the
# bytes never do. Leave the credentials unset to use boto3's own chain (an instance role, or
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY), which is how a deployment should authenticate.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=soccom-attachments
S3_USE_PATH_STYLE=true
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: local development values for the Compose
# object-storage service, which accepts any credentials but still requires a signature. A
# deployment leaves these unset and authenticates through boto3's own chain so no static key
# ships with the image.
S3_ACCESS_KEY_ID=soccom-local
S3_SECRET_ACCESS_KEY=soccom-local-dev
# Uploads are scanned before they are downloadable. Unset runs the structural validator only,
# which refuses markup, executables, and any type that disagrees with the bytes; production
# requires CLAMAV_HOST so that content is inspected as well.
# CLAMAV_HOST=localhost
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MESSAGE_LIMIT=4
ATTACHMENT_ACCOUNT_QUOTA_BYTES=1073741824
ATTACHMENT_UPLOAD_TTL_SECONDS=900

# A post's media outlives its first reader, so its ceilings are per kind rather than one number:
# a photo is small, a short clip is not, and a track sits between. The composer states these
# same numbers beside the picker, so the page and the server never disagree.
POST_MEDIA_LIMIT=4
POST_IMAGE_MAX_BYTES=10485760
POST_VIDEO_MAX_BYTES=52428800
POST_AUDIO_MAX_BYTES=26214400

# ICE configuration for calls, comma separated. Media is a mesh of peer-to-peer connections and
# never passes through the application; STUN covers most home and mobile networks.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
# TURN is the relay of last resort for peers behind symmetric NAT, and it forwards ciphertext it
# cannot read. Credentials are minted per session in the coturn REST convention, so set both the
# URL list and the shared secret. A TURN URL without a secret is not offered to browsers.
# WEBRTC_TURN_URLS=turn:relay.example.com:3478?transport=udp
# WEBRTC_TURN_SECRET=change-me
WEBRTC_TURN_TTL_SECONDS=300

# Calls are a mesh: every participant holds one uplink per other participant, so the participant
# ceiling, the per-worker call cap, the ring timeout, and the two rate limits are enforced
# server-side.
CALL_MAX_PARTICIPANTS=8
CALL_CONCURRENT_LIMIT=50
CALL_RING_TIMEOUT_SECONDS=45
CALL_START_LIMIT_PER_MINUTE=10
CALL_SIGNAL_LIMIT_PER_MINUTE=240
