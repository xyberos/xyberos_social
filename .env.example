APP_ENV=development
DATABASE_URL=postgresql+psycopg://soccom:soccom@localhost:5433/soccom
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=accounts@soccom.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# LOG_JSON pins structured JSON logs on or off; unset means JSON everywhere except development.
# S3-compatible object storage for attachment bytes. Attachment rows stay in PostgreSQL; the
# bytes never do. Leave the credentials unset to use boto3's own chain (an instance role, or
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY), which is how a deployment should authenticate.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=soccom-attachments
S3_USE_PATH_STYLE=true
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: local development values for the Compose
# object-storage service, which accepts any credentials but still requires a signature. A
# deployment leaves these unset and authenticates through boto3's own chain so no static key
# ships with the image.
S3_ACCESS_KEY_ID=soccom-local
S3_SECRET_ACCESS_KEY=soccom-local-dev
# Uploads are scanned before they are downloadable. Unset runs the structural validator only,
# which refuses markup, executables, and any type that disagrees with the bytes; production
# requires CLAMAV_HOST so that content is inspected as well.
# CLAMAV_HOST=localhost
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MESSAGE_LIMIT=4
ATTACHMENT_ACCOUNT_QUOTA_BYTES=209715200
ATTACHMENT_UPLOAD_TTL_SECONDS=900
